# --- Supabase (create a dedicated "reforge" project; each project = its own Postgres DB) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
DATABASE_URL=                         # direct Postgres connection string (pgvector)

# --- Storage backend: local | r2 ---
STORAGE_BACKEND=local
LOCAL_LIBRARY_DIR=./library          # original clips (gitignored)
LOCAL_DATA_DIR=./data                # proxies, thumbnails, scratch (gitignored)
# Cloudflare R2 (when STORAGE_BACKEND=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=reforge-clips

# --- Vision / embedding models ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
CLIP_MODEL=ViT-L-14                  # open_clip; 768-dim
CLIP_PRETRAINED=laion2b_s32b_b82k
TEXT_EMBED_MODEL=text-embedding-3-small   # 1536-dim
# Optional eval benchmark
TWELVELABS_API_KEY=

# --- Render ---
OUTPUT_DIR=./output

# --- LLM gateway (optional): set to route Claude calls through Vercel AI Gateway ---
# Unset = direct Anthropic. Model ids unchanged either way.
AI_GATEWAY_API_KEY=
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh

# --- Public demo ---
# DEMO_READ_ONLY=1 refuses every non-GET request with 403 (browse, never write).
# DEMO_FIXTURES=1 serves the bundled synthetic data in demo/ instead of Postgres.
DEMO_READ_ONLY=
DEMO_FIXTURES=
# Optional access gate for a private deploy: visitors pass ?code=<value> once.
INVITE_CODE=

# --- Trial-reel publishing (scripts/publish_worker.py) ---
# DRY-RUN BY DEFAULT: a real provider only fires when BOTH are set.
# PUBLISH_PROVIDER=upload_post | graph        (unset = dry_run)
# PUBLISH_LIVE=1                              (the live latch - required for any real post)
PUBLISH_PROVIDER=
PUBLISH_LIVE=
PUBLISH_TZ=America/New_York                   # schedule form + display timezone
PUBLISH_GRADUATION=MANUAL                     # graph provider: MANUAL | SS_PERFORMANCE
# upload_post provider (connect IG once at upload-post.com; no Meta dev app needed)
UPLOAD_POST_API_KEY=
UPLOAD_POST_USER=
# graph provider (direct Meta API: IG professional account + Meta app + content-publish perm)
IG_USER_ID=
IG_ACCESS_TOKEN=
